{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "▶ Run SkillGraph",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/backend/app.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "serverReadyAction": {
        "pattern": "Running on (https?://\\S+)",
        "uriFormat": "%s",
        "action": "openExternally"
      },
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "▶ Run SkillGraph (Streamlit)",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": [
        "run",
        "streamlit_app.py"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": true
    },
    {
      "name": "🖼 Download photos (once, needs internet)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/fetch_images.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "⬇ Fetch Adzuna openings → CSV",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/fetch_adzuna_jobs.py",
      "args": [
        "--country",
        "in",
        "--where",
        "Chennai"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "✔ Run tests",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/backend/test_app.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Pipeline 1 · build knowledge graph",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/pipeline/src/kg_build.py",
      "args": [
        "raw"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Pipeline 2 · Node2Vec + HGT + evaluation",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/pipeline/src/kg_models.py",
      "args": [
        "0,1,2"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Pipeline 3 · explanation + figures",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/pipeline/src/kg_report.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Pipeline 4 · export data for the website",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/pipeline/src/export_web.py",
      "args": [
        "raw"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Pipeline 5 · experiments (weighting ablation + standard recommenders)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/pipeline/src/kg_experiments.py",
      "args": [
        "0,1,2"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Pipeline 6 · paper figures (Fig. 2, Fig. 3)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/pipeline/src/kg_paper_figures.py",
      "args": [],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}